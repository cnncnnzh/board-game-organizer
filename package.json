{
  "name": "board-game-organizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Anonymous board game event organization",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "start:production": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "db:migrate": "tsx src/migrate.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3"
  }
}
