HOST=127.0.0.1
PORT=3000
# Leave DATABASE_URL empty for a persistent local PGlite database.
# Production requires external PostgreSQL and NODE_ENV=production.
DATABASE_URL=
DATA_DIR=./data/board-games
# Local URL; on Render leave PUBLIC_ORIGIN unset to use RENDER_EXTERNAL_URL.
# Set PUBLIC_ORIGIN explicitly when using a custom HTTPS domain.
PUBLIC_ORIGIN=http://localhost:3000
# Use npm run start:test to enable local test tools; production always disables them.
ENABLE_TEST_TOOLS=false
HOUSEKEEPING_INTERVAL_MS=300000
SESSION_DAYS=180
